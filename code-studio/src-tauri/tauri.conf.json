{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Code Studio",
  "version": "0.1.0",
  "identifier": "dev.codestudio.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Code Studio",
        "width": 1440,
        "height": 920,
        "minWidth": 760,
        "minHeight": 500,
        "backgroundColor": "#171b20"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": []
  }
}
