<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="400dp"
    android:height="400dp"
    android:viewportWidth="400"
    android:viewportHeight="400">

    <!-- Background -->
    <path android:pathData="M40,0 L360,0 A40,40 0 0 1 400,40 L400,360 A40,40 0 0 1 360,400 L40,400 A40,40 0 0 1 0,360 L0,40 A40,40 0 0 1 40,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="200"
                android:centerY="200"
                android:gradientRadius="200"
                android:type="radial">
                <item android:color="#FF0E1628" android:offset="0.0"/>
                <item android:color="#FF060910" android:offset="1.0"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Core Glow -->
    <path android:pathData="M200,200m-160,0a160,160 0,1 1,320 0a160,160 0,1 1,-320 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="200"
                android:centerY="200"
                android:gradientRadius="160"
                android:type="radial">
                <item android:color="#2E00FFE0" android:offset="0.0"/>
                <item android:color="#0000FFE0" android:offset="1.0"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Lambda Symbol Spine and Arms -->
    <path
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:pathData="M148,148 L200,230 L252,148 M200,230 L200,268 M200,268 L168,300 M200,268 L232,300">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="148"
                android:startY="148"
                android:endX="232"
                android:endY="300"
                android:type="linear">
                <item android:color="#FF00FFE0" android:offset="0.0"/>
                <item android:color="#FF38BDF8" android:offset="0.55"/>
                <item android:color="#FFA78BFA" android:offset="1.0"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Apex and Junction Glows -->
    <path android:fillColor="#FF00FFE0" android:pathData="M200,230m-6,0a6,6 0,1 1,12 0a6,6 0,1 1,-12 0"/>
    <path android:fillColor="#FFA78BFA" android:pathData="M200,268m-4,0a4,4 0,1 1,8 0a4,4 0,1 1,-4 0"/>

    <!-- White core centers -->
    <path android:fillColor="#FFFFFF" android:pathData="M200,230m-2,0a2,2 0,1 1,4 0a2,2 0,1 1,-4 0"/>
    <path android:fillColor="#FFFFFF" android:pathData="M200,268m-1.5,0a1.5,1.5 0,1 1,3 0a1.5,1.5 0,1 1,-3 0"/>

    <!-- Gold accent ticks -->
    <path
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M174,190 L226,190">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="174"
                android:startY="190"
                android:endX="226"
                android:endY="190"
                android:type="linear">
                <item android:color="#FFF5C542" android:offset="0.0"/>
                <item android:color="#FFE07B39" android:offset="1.0"/>
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M178,198 L222,198"
        android:strokeAlpha="0.5">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="178"
                android:startY="198"
                android:endX="222"
                android:endY="198"
                android:type="linear">
                <item android:color="#FFF5C542" android:offset="0.0"/>
                <item android:color="#FFE07B39" android:offset="1.0"/>
            </gradient>
        </aapt:attr>
    </path>
</vector>